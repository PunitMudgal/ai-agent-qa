{
  "name": "ai-agent-qa",
  "version": "1.0.0",
  "description": "AI-powered QA test case generator for Node.js backend projects",
  "main": "dist/server.js",
  "bin": {
    "ai-agent-qa": "./dist/cli.js"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec \"ts-node --transpile-only\" src/server.ts",
    "cli": "node dist/cli.js",
    "generate": "node dist/cli.js generate",
    "scan": "node dist/cli.js scan --project ./",
    "test": "npm run build && node --test tests/*.test.js"
  },
  "keywords": [
    "qa",
    "test-case",
    "ai",
    "groq",
    "swagger",
    "openapi",
    "test-generator"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@google/genai": "^1.43.0",
    "acorn": "^8.16.0",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "groq-sdk": "^0.5.0",
    "js-yaml": "^4.1.0",
    "marked": "^12.0.1",
    "multer": "^1.4.5-lts.1",
    "ora": "^5.4.1",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2"
  }
}
