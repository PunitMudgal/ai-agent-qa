{
  "name": "qa-test-generator",
  "version": "1.0.0",
  "description": "AI-powered QA test case generator for Node.js backend projects",
  "main": "dist/server.js",
  "bin": {
    "qa-gen": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec \"ts-node --transpile-only\" src/server.ts",
    "cli": "node dist/cli.js",
    "generate": "node dist/cli.js generate",
    "scan": "node dist/cli.js scan --project ./",
    "test": "echo \"Run: npm run build && node dist/cli.js swagger --input tests/sample.swagger.json\""
  },
  "keywords": [
    "qa",
    "test-case",
    "ai",
    "groq",
    "swagger",
    "openapi",
    "test-generator"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "acorn": "^8.16.0",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "groq-sdk": "^0.5.0",
    "js-yaml": "^4.1.0",
    "marked": "^12.0.1",
    "multer": "^1.4.5-lts.1",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  }
}
