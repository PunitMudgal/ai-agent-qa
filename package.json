{
  "name": "qa-test-generator",
  "version": "1.0.0",
  "description": "AI-powered QA test case generator for Node.js backend projects",
  "main": "src/server.js",
  "bin": {
    "qa-gen": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "cli": "node src/cli.js",
    "dev": "nodemon src/server.js",
    "generate": "node src/cli.js generate",
    "scan": "node src/cli.js scan --project ./",
    "test": "echo \"Run: node src/cli.js swagger --input tests/sample.swagger.json\""
  },
  "keywords": [
    "qa",
    "test-case",
    "ai",
    "groq",
    "swagger",
    "openapi",
    "test-generator"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "groq-sdk": "^0.5.0",
    "js-yaml": "^4.1.0",
    "marked": "^12.0.1",
    "multer": "^1.4.5-lts.1",
    "ora": "^5.4.1"
  }
}
