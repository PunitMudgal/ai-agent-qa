# AI API Configuration - at least one required
# Groq (primary, free at console.groq.com)
GROQ_API_KEY=groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (fallback when Groq limit reached or not configured, free at aistudio.google.com/apikey)
# GEMINI_API_KEY=gemini-api-key
# GEMINI_MODEL=gemini-2.0-flash

# Server Configuration
PORT=3000
NODE_ENV=development

# Generation Defaults
DEFAULT_MIN_TESTS_PER_ENDPOINT=10
DEFAULT_OUTPUT_DIR=./output
DEFAULT_FORMAT=both

# Optional: Logging
LOG_LEVEL=info
