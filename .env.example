# Groq API Configuration (free at console.groq.com)
GROQ_API_KEY=groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Server Configuration
PORT=3000
NODE_ENV=development

# Generation Defaults
DEFAULT_MIN_TESTS_PER_ENDPOINT=10
DEFAULT_OUTPUT_DIR=./output
DEFAULT_FORMAT=both

# Optional: Logging
LOG_LEVEL=info
